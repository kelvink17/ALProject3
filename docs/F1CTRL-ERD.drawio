<mxfile host="app.diagrams.net" modified="2026-10-28T15:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="f1ctrl-erd" name="F1CTRL ERD">
    <mxGraphModel dx="2700" dy="2300" grid="1" gridSize="10" guides="1" page="1" pageWidth="2850" pageHeight="2350">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="F1CTRL — Entity Relationship Diagram" style="text;html=1;fontSize=30;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="800" height="50" as="geometry"/></mxCell>
        <mxCell id="intro" value="Each box is one database entity. Each line represents one separate relationship—no relationship lines are joined together. Blue entities were created for F1CTRL; grey entities are standard Business Central tables extended by F1CTRL." style="rounded=1;whiteSpace=wrap;html=1;spacing=16;fontSize=15;fillColor=#F9FAFB;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="1750" height="75" as="geometry"/></mxCell>

        <mxCell id="item" value="&lt;b&gt;ITEM&lt;/b&gt;&lt;br&gt;&lt;i&gt;A part or finished product kept in stock.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;Description&lt;br&gt;Inventory&lt;br&gt;Base Unit of Measure" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="300" height="220" as="geometry"/></mxCell>
        <mxCell id="assembly" value="&lt;b&gt;ASSEMBLY HEADER&lt;/b&gt;&lt;br&gt;&lt;i&gt;Instructions for building an F1 item.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; Document Type + No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; F1 Race No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; Item No.&lt;br&gt;Quantity&lt;br&gt;Location Code" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="510" width="320" height="250" as="geometry"/></mxCell>
        <mxCell id="usage" value="&lt;b&gt;F1 INVENTORY USAGE&lt;/b&gt;&lt;br&gt;&lt;i&gt;History of parts consumed or returned.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; Entry No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; Race No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; Item No.&lt;br&gt;Quantity Used&lt;br&gt;Posted Assembly No.&lt;br&gt;Reverses Entry No." style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1660" y="500" width="330" height="270" as="geometry"/></mxCell>
        <mxCell id="postedAssembly" value="&lt;b&gt;POSTED ASSEMBLY HEADER&lt;/b&gt;&lt;br&gt;&lt;i&gt;Permanent proof that an item was built.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; F1 Race No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; Item No.&lt;br&gt;Quantity&lt;br&gt;Posting Date" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2070" y="850" width="330" height="250" as="geometry"/></mxCell>

        <mxCell id="member" value="&lt;b&gt;F1 TEAM MEMBER&lt;/b&gt;&lt;br&gt;&lt;i&gt;A person who works for the racing team.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;Name&lt;br&gt;Role&lt;br&gt;Email&lt;br&gt;Phone No.&lt;br&gt;Blocked" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="300" height="260" as="geometry"/></mxCell>
        <mxCell id="assignment" value="&lt;b&gt;F1 TEAM ASSIGNMENT&lt;/b&gt;&lt;br&gt;&lt;i&gt;Links a team member to a race.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; Race No.&lt;br&gt;&lt;b&gt;PK, FK&lt;/b&gt; Team Member No.&lt;br&gt;Role&lt;br&gt;Notes&lt;br&gt;Member Name&lt;br&gt;Race Name" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="880" width="320" height="260" as="geometry"/></mxCell>
        <mxCell id="race" value="&lt;b&gt;F1 RACE EVENT&lt;/b&gt;&lt;br&gt;&lt;i&gt;The main record for one Grand Prix.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;Name&lt;br&gt;Race Date&lt;br&gt;Location&lt;br&gt;Circuit&lt;br&gt;Status&lt;br&gt;Season" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=14;fillColor=#BFDBFE;strokeColor=#1D4ED8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1080" y="850" width="330" height="290" as="geometry"/></mxCell>

        <mxCell id="vendor" value="&lt;b&gt;VENDOR&lt;/b&gt;&lt;br&gt;&lt;i&gt;A company supplying parts to the team.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;Name&lt;br&gt;F1 Vendor Score" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="purchase" value="&lt;b&gt;PURCHASE HEADER&lt;/b&gt;&lt;br&gt;&lt;i&gt;An order for race parts.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; Document Type + No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; F1 Race No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; Buy-from Vendor No.&lt;br&gt;Purchase Urgency&lt;br&gt;Vendor Score" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="1390" width="330" height="250" as="geometry"/></mxCell>
        <mxCell id="receipt" value="&lt;b&gt;PURCHASE RECEIPT HEADER&lt;/b&gt;&lt;br&gt;&lt;i&gt;Proof that race parts were delivered.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; F1 Race No.&lt;br&gt;Buy-from Vendor No.&lt;br&gt;Posting Date" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="1740" width="330" height="230" as="geometry"/></mxCell>
        <mxCell id="purchaseInvoice" value="&lt;b&gt;PURCHASE INVOICE HEADER&lt;/b&gt;&lt;br&gt;&lt;i&gt;The supplier’s final bill for race spending.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; F1 Race No.&lt;br&gt;Buy-from Vendor No.&lt;br&gt;Amount&lt;br&gt;Posting Date" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1320" y="1740" width="340" height="240" as="geometry"/></mxCell>
        <mxCell id="sales" value="&lt;b&gt;SALES HEADER&lt;/b&gt;&lt;br&gt;&lt;i&gt;Expected sponsorship income for a race.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; Document Type + No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; F1 Race Event No.&lt;br&gt;Sell-to Customer No.&lt;br&gt;Amount" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1710" y="1390" width="330" height="230" as="geometry"/></mxCell>
        <mxCell id="salesInvoice" value="&lt;b&gt;SALES INVOICE HEADER&lt;/b&gt;&lt;br&gt;&lt;i&gt;Confirmed sponsorship revenue for a race.&lt;/i&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; No.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; F1 Race Event No.&lt;br&gt;Sell-to Customer No.&lt;br&gt;Amount&lt;br&gt;Posting Date" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fontSize=13;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2150" y="1390" width="340" height="240" as="geometry"/></mxCell>

        <mxCell id="eMemberAssignment" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;strokeColor=#2563EB;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="member" target="assignment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRaceAssignment" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;strokeColor=#2563EB;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="race" target="assignment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRaceAssembly" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=0.15;exitY=0;entryX=1;entryY=1;" edge="1" parent="1" source="race" target="assembly"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eItemAssembly" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=0;exitY=0.7;entryX=1;entryY=0;" edge="1" parent="1" source="item" target="assembly"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRaceUsage" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;strokeColor=#2563EB;exitX=1;exitY=0.25;entryX=0;entryY=1;" edge="1" parent="1" source="race" target="usage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eItemUsage" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=1;exitY=0.7;entryX=0;entryY=0;" edge="1" parent="1" source="item" target="usage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRacePostedAssembly" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=1;exitY=0.6;entryX=0;entryY=0.6;" edge="1" parent="1" source="race" target="postedAssembly"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ePostedAssemblyUsage" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;dashed=1;exitX=0;exitY=0.1;entryX=1;entryY=1;" edge="1" parent="1" source="postedAssembly" target="usage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eVendorPurchase" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vendor" target="purchase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRacePurchase" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=0.1;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="race" target="purchase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRaceReceipt" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=0.35;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="race" target="receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRacePurchaseInvoice" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=0.65;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="race" target="purchaseInvoice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRaceSales" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=0.9;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="race" target="sales"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRaceSalesInvoice" style="edgeStyle=none;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;strokeWidth=2;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="race" target="salesInvoice"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;HOW TO READ THE RELATIONSHIPS&lt;/b&gt;&lt;br&gt;&lt;br&gt;The single end means &lt;b&gt;ONE&lt;/b&gt;.&lt;br&gt;The forked end means &lt;b&gt;MANY&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Examples:&lt;br&gt;• One race can have many team assignments.&lt;br&gt;• One member can have many assignments.&lt;br&gt;• One race can have many assembly orders.&lt;br&gt;• One item can appear in many usage entries.&lt;br&gt;• One vendor can have many purchase orders.&lt;br&gt;• One race can have many purchasing and sales documents.&lt;br&gt;&lt;br&gt;The dashed line means inventory usage is created from posted assembly history." style="rounded=1;whiteSpace=wrap;html=1;spacing=18;fontSize=14;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2180" y="220" width="540" height="500" as="geometry"/></mxCell>
        <mxCell id="key" value="&lt;b&gt;KEY&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; = Primary Key: the unique identity of a record.&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; = Foreign Key: a field that connects the record to another entity." style="rounded=1;whiteSpace=wrap;html=1;spacing=16;fontSize=14;fillColor=#F9FAFB;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="2180" y="740" width="540" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
